---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "seyran",
  description = "my site"
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title="Seyran" href="/rss.xml" />
    <title>{title}</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />

    <!-- Cloudflare Web Analytics. is:inline — иначе Astro утащит тег в свою
         сборку и потеряет data-cf-beacon, без которого маячок бесполезен -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "0ed6eb1efb8f4ade8f3de186636ca3ae"}'
    ></script>
  </body>
</html>
