---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import MusicList from '../components/MusicList';
import { getTracksFromNotion } from '../lib/notion';

const tracks = await getTracksFromNotion();
---

<BaseLayout title="Media — Seyran">
  <div class="min-h-screen px-6 md:px-12 py-12 md:py-20">
    <div class="max-w-4xl mx-auto">

      {/* Header with Navigation */}
      <Header client:load />

      {/* Page Title */}
      <div class="mb-12">
        <h1 class="text-4xl font-bold text-white mb-2">Media</h1>
        <p class="text-zinc-500">Music</p>
      </div>

      {/* Tracks */}
      {tracks.length > 0 ? (
        <MusicList client:load tracks={tracks} />
      ) : (
        <div class="text-center py-20">
          <p class="text-zinc-500 text-lg">
            No tracks yet. Add your first track in Notion!
          </p>
        </div>
      )}

    </div>
  </div>
</BaseLayout>
