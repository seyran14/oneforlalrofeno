---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';

// Ручной список — сеты заливаются на R2 и добавляются сюда вручную,
// поэтому никакого fetch/CMS тут нет.
const sets = [
  {
    title: 'Back to The Decs',
    video: 'https://videos.seyran.cc/sets/back-to-the-decks.mov',
  },
];
---

<BaseLayout title="Sets — Seyran">
  <div class="min-h-screen px-6 md:px-12 py-12 md:py-20">
    <div class="max-w-4xl mx-auto">

      <Header client:load />

      <div class="mb-12">
        <h1 class="text-4xl font-bold text-white mb-2">Sets</h1>
        <p class="text-zinc-500">Video</p>
      </div>

      <div class="space-y-16">
        {sets.map((set) => (
          <div>
            <h2 class="text-xl font-semibold text-white mb-4">{set.title}</h2>
            <video
              controls
              playsinline
              preload="auto"
              class="w-full h-auto bg-black rounded-lg border border-zinc-800"
            >
              <source src={set.video} />
              Your browser does not support embedded video playback.
            </video>
            <p class="mt-3 text-xs text-zinc-600">
              If the video doesn't play directly in the browser (can happen on Windows) —{' '}
              <a href={set.video} class="text-zinc-400 hover:text-white underline underline-offset-2">
                download the file
              </a>{' '}
              and open it in VLC.
            </p>
          </div>
        ))}
      </div>

    </div>
  </div>
</BaseLayout>
