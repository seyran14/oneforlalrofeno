---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Seyran">
  <main class="min-h-screen flex items-center justify-center px-6 py-20">
    <div class="max-w-xl text-center fade-in">
      <p class="text-xl md:text-2xl text-white leading-relaxed">
        Boredom isn’t when you have nothing to do. It’s when nothing you could do
        motivates you enough to actually do it.
      </p>

      <p class="mt-8 text-xl md:text-2xl text-white">
        I’m never bored.
      </p>

      <p class="mt-12 font-mono text-sm text-zinc-500">404</p>

      <a
        href="/"
        class="inline-block mt-10 text-sm text-zinc-600 hover:text-white transition-colors duration-200"
      >
        Home
      </a>
    </div>
  </main>
</BaseLayout>

<style>
  /* Тот же характер появления, что и у остального сайта, но без React —
     ради страницы ошибки незачем тянуть на клиент целый компонент */
  .fade-in {
    animation: fade-in 0.6s ease-out both;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in {
      animation: none;
    }
  }
</style>
